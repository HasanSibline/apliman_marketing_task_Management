# AI Service Configuration
PORT=8001
ENVIRONMENT=development

# AI Provider Configuration
# IMPORTANT: AI API keys are NOT configured here. Every AI request carries a key chosen
# by the backend from the company's AI provider chain (Settings → AI providers). The service never reads API keys from the environment;
# GOOGLE_API_KEY / GROQ_API_KEY are intentionally unused at runtime. Only the model
# names and tuning values below are read from the environment.
# Optional. Leave unset to use the defaults in config.py. A provider entry that pins a
# model in Settings overrides these for that entry. Never set a retired model here:
# gemini-2.0-flash was shut down on 2026-06-01 and every Gemini call then fails.
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b

# Claude / Anthropic. A provider entry can pin its own model in Settings, which
# overrides this. Defaults to claude-haiku-5-5; set claude-sonnet-5-5 or claude-opus-5-5
# here only if every Anthropic entry should use the dearer model.
# ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=8192      # Thinking + response share this budget
ANTHROPIC_EFFORT=medium        # low | medium | high | xhigh | max

# Model Configuration
MODEL_CACHE_DIR=./models
MAX_SUMMARY_LENGTH=150
DEFAULT_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_REQUESTS=60  # requests per minute
RATE_LIMIT_INTERVAL=60  # interval in seconds

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=1  # seconds

# Cache Configuration
CACHE_ENABLED=true
CACHE_TTL=3600  # seconds

# OCR Configuration (optional)
TESSERACT_CMD=/usr/bin/tesseract

# Logging
LOG_LEVEL=INFO

# CORS Configuration - restrict to backend server origins only (not the browser frontend)
ALLOWED_ORIGINS=http://localhost:3001,https://your-backend.onrender.com

# AI Service Authentication
# Must match AI_SERVICE_SECRET in the backend .env
# Generate with: openssl rand -hex 32
AI_SERVICE_SECRET=change-this-to-a-strong-random-secret